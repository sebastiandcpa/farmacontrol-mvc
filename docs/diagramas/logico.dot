digraph G {graph[fontname="Arial",fontsize=18,bgcolor="white",pad="0.25",nodesep="0.35",ranksep="0.55"]; node[fontname="Arial",fontsize=16,color="#555555",margin="0.16,0.12"]; edge[fontname="Arial",fontsize=12,color="#666666"]; rankdir=TB; node[shape=record]; Rol[label="{Rol|PK rol_id|nombre UQ}"]; Usuario[label="{Usuario|PK usuario_id|FK rol_id\lcorreo UQ\lhash_contrasena\lactivo}"]; Cliente[label="{Cliente|PK cliente_id|UQ tipo_documento, numero_documento}"]; Categoria[label="{Categoria|PK categoria_id|nombre UQ}"]; Medicamento[label="{Medicamento|PK medicamento_id|FK categoria_id\lsku UQ\lprecio_venta\lrequiere_receta}"]; Lote[label="{Lote|PK lote_id|FK medicamento_id\lUQ medicamento_id, codigo_lote\lfecha_vencimiento\lstock_actual no negativo}"]; Receta[label="{Receta|PK receta_id|FK cliente_id\lFK registrado_por\lnumero_receta UQ\lfechas, estado}"]; Venta[label="{Venta|PK venta_id|FK cliente_id, usuario_id\lFK receta_id NULL\lFK anulado_por NULL\lUQ tipo, numero_comprobante}"]; DetalleVenta[label="{DetalleVenta|PK detalle_venta_id|FK venta_id, lote_id\lcantidad, precio_unitario\lsubtotal calculado}"]; Compra[label="{Compra|PK compra_id|FK proveedor_id, usuario_id\lUQ proveedor_id, numero_documento}"]; DetalleCompra[label="{DetalleCompra|PK detalle_compra_id|FK compra_id, lote_id\lcantidad, costo_unitario\lsubtotal calculado}"]; Proveedor[label="{Proveedor|PK proveedor_id|ruc UQ\lactivo}"]; MovimientoStock[label="{MovimientoStock|PK movimiento_id|FK lote_id, usuario_id\lFK compra_id NULL\lFK venta_id NULL\ltipo, cantidad, fecha}"];edge[dir=none];Rol->Usuario;Categoria->Medicamento;Medicamento->Lote;Cliente->Receta;Cliente->Venta;Receta->Venta;Usuario->Venta;Proveedor->Compra;Compra->DetalleCompra;Venta->DetalleVenta;Lote->DetalleVenta;Lote->DetalleCompra;Lote->MovimientoStock;Venta->MovimientoStock;Compra->MovimientoStock; }